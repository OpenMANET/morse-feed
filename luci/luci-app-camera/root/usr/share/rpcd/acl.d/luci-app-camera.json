{
	"luci-app-camera": {
		"description": "Grant access to rpcd-mod-onvif proxy",
		"read": {
			"ubus": {
				"onvif": [ "probe", "info", "get_stream" ],
				"mediamtx": [ "get_ports" ],
				"luci-rpc": [ "callLuciNetworkDevices" ],
			},
			"uci": [ "cameras", "wireless", "aws_kvs" ]
		},
		"write": {
			"ubus": {
				"onvif": [ "set_encoder", "set_imaging" ],
				"mediamtx": [ "set_proxy" ]
			},
			"uci": [ "cameras", "wireless", "aws_kvs" ]
		}
	}
}
