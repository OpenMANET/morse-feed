{
	"luci-app-rangetest": {
		"description": "Grant access to the LuCI range test app",
		"write": {
			"ubus": {
				"umdns": [ "update", "browse" ],
				"rangetest": [ 
					"background_iperf3_server",
					"background_iperf3_client",
					"get_background",
					"terminate_background",
					"iw_station_dump",
					"morse_cli_stats_reset",
					"morse_cli_stats",
					"morse_cli_channel",
					"ip_link",
					"remote_device_login",
					"remote_device_call" 
				]
			},
			"file": {
				"/tmp/rangetest/*": [ "write", "remove" ]
			}
		},
		"read": {
			"file": {
				"mkdir -p /tmp/rangetest" : [ "exec" ],
				"/tmp/rangetest" : [ "list" ],
				"/tmp/rangetest/*" : [ "read" ]
			},
			"ubus": {
				"iwinfo": [ "info" ]
			}
		}
	},
	"unauthenticated": {
		"description": "Allow unauthenticated users to check the status of the range test app",
		"read": {
			"ubus": {
				"rangetest": [ "info" ]
			}
		}
	}
}