/**
 * Collect the ip_link output.
 * 
 * This command is run on both the local and remote in order to
 * identify the connected interface for the iwinfo command which
 * is used to collect the channel number.
 */
function ip_link(req) {
	let output = {};
	let devices, device, results, json_results;

	try {
		devices = _get_morse_devices();
	} catch (error) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'No Morse Micro 802.11ah Wi-Fi devices found. Please check that your Morse Micro HaLow Wi-Fi is correctly enabled and configured before trying again.',
			error
		);
	}

	for (device in devices) {
		try {
			results = _execute_command(`ip -j -d link show ${device}`);
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to collect channel information. This may affect the accuracy of results. If the problem persists, consider rebooting the device.',
				error
			);
		}

		if (results.exit_code == 0) {
			try {
				json_results = json(results.output);
			} catch (error) {
				return _error_response(
					ubus.STATUS_PARSE_ERROR,
					'Unable to collect channel information. This may affect the accuracy of results. If the problem persists, consider rebooting the device.',
					`Received invalid JSON (${results.output}[:100]): ${[substr(results.output, 0, 100)]}`
				);
			}
			
			output[device] = json_results[0];
		} else {
			output[device] = '';
		}
	}
	return output;
}

/**
 * Just the API version for now, but could easily be extended
 * to include information about whether there is an existing
 * rangetest in progress by checking the output directories.
 */
function info(req) {
	return { rangetest_api_version: API_VERSION };
}

/**
 * Use uclient-fetch to make a POST request to a remote device.
 * 
 * This writes to a temporary file and then immediately reads out of
 * it due to the nature of execv with system calls. 
 */
function _uclient_fetch(url, post_data) {
	const command = ['uclient-fetch', '-q', '-T', '10', '--post-data', post_data, url];

	/* Create the range test output directory if it doesn't exist. */
	if (!fs.access(BG_OUTPUT_DIR, 'f') && fs.mkdir(BG_OUTPUT_DIR) === null) {
		die(`Unable to create directory ${BG_OUTPUT_DIR} (${fs.error()}).`);
	}

	/* Create the temporary file to capture request returns. */
	const temp_file_path = `${BG_OUTPUT_DIR}/uclient-fetch-${math.rand()}`;
	if (fs.writefile(temp_file_path, "") === null) {
		die(`Unable to create temporary file (${fs.error()}).`);
	}

	try {
		/* Redirect the output of uclient-fetch to the temporary file. */
		push(command, '-O', temp_file_path);
		
		const exit_code = system(command, 13000);
		if (exit_code != 0) {
			die(`uclient-fetch returned a non-zero exit code (${exit_code}).`);
		}
		
		const output_data = fs.readfile(temp_file_path);
		if (output_data === null) {
			die(`Unable to read from temporary file (${fs.error()}).`);
		}

		try {
			fs.unlink(temp_file_path);
            return json(output_data);
        } catch (error) {
            die(`Received invalid JSON (${output_data}[:100]): ${[substr(output_data, 0, 100)]}`);
        }
	} catch (error) {
		fs.unlink(temp_file_path);
		die(`${error}`);
	}
}

function remote_device_login(req) {
	if (iptoarr(req.args.target) === null) {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, 'Invalid target IP address.');
	}

	if (req.args.password === null) {
		req.args.password = '';
	}

	const url = `http://${req.args.target}/ubus/`;
	const post_data = {
		id: 0,
		method: 'call',
		jsonrpc: '2.0',
		params: [
			'00000000000000000000000000000000',
			'session',
			'login',
			{
				username: 'root',
				password: req.args.password,
			}
		]
	};

	return _uclient_fetch(url, post_data);
}

function remote_device_call(req) {
	
	if (iptoarr(req.args.target) === null) {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, 'Invalid target IP address.');
	}
	
	if (req.args.rpc_id === null) {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, 'Invalid RPC ID.');
	}

	if (req.args.session_id === null) {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, 'Invalid session ID.');
	}
	
	if (req.args.method === null || req.args.method === 'remote_device_call') {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, 'Invalid method.');
	}
	
	if (req.args.args === null) {
		args = {};
	}
	
	const url = `http://${req.args.target}/ubus/`;
	const post_data = {
		id: req.args.rpc_id,
		method: 'call',
		jsonrpc: '2.0',
		params: [
			req.args.session_id,
			'rangetest',
			req.args.method,
			req.args.args
