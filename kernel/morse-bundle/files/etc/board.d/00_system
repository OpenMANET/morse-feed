. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board=$(board_name)

board_config_update

. /etc/device_info

mac_label="$(get_mac_label)"
if [ -z "$mac_label" ]; then
	mac_label="$(cat /sys/class/net/eth0/address)"
fi

if [ -n "$mac_label" ]; then
	suffix="$(echo "$mac_label" | tr -d ':' | tr A-Z a-z)"
	case "$(cat /tmp/sysinfo/board_name)" in
		glinet,gl-mt3000)
			suffix=${suffix: -3}
		;;
		*)
			suffix=${suffix: -4}
		;;
	esac
else
	suffix="z$(tr -dc 'a-f0-9' </dev/urandom | head -c 3)"
fi

if [ -n "${DEVICE_PRODUCT}" ] && [ "$DEVICE_PRODUCT" != Generic ]; then
	prefix="${DEVICE_PRODUCT}"
else
	# Model without manufacturer (i.e. strip MorseMicro) and revision.
	case "$(cat /tmp/sysinfo/board_name)" in
		glinet,gl-mt3000)
			prefix=GL-MT3000
		;;
		*)
			prefix="$(sed "s/$DEVICE_MANUFACTURER //;s/ *[v-][0-9]*$//" /tmp/sysinfo/model | tr A-Z a-z)"
		;;
	esac
fi

ucidef_set_hostname "$(echo "$prefix-$suffix" | tr -c -d 'A-Za-z0-9_-')"

board_config_flush

exit 0
