/* Provide some DPP related functionality.
 *
 * For the moment, this is the push button initiation, and a callback handler for
 * wpa_event_listener (sort of...).
 *
 * FUTURE WORK = become a daemon and manage the whole process:
 *  - don't maintain lockout state here (since hostapd knows...)
 * 	  - hostap should fail button press if session overlap is likely
 *      (trickier than it sounds, unless we force configurator to be button pressed first)
 *    - hostap should tell us in the failure message how long to lockout for
 *      (at the moment, this is in wpa_event_listener)
 *  - single connection to hostapd/wpa_supplicant to trigger push button and get state info
 *  - hostapd/wpa_supplicant can report appropriate lockout info
 *    (i.e. figure out if we're likely to have a clash issue based on last transmission or last
 *    receipt)
 *  - no strange 'jump out to wpa_event_listener to feed back into our states'
 *  - and eventually, handle all dppd related functionality as well.
 */
"use strict";


import { connect } from  "ubus";
import { cursor } from "uci";
import { access, lsdir, unlink, readfile, writefile } from "fs";


const DPP_ACTION_SCRIPT = "/lib/netifd/morse/wpa_s1g_dpp_action.sh";
const DPP_STATE_INFO = "/tmp/dpp_state_info.json";

// Note that this is an 'assoc LED' because that's what morse_led0 defaults to
// in the driver at the moment. We rely entirely on this path and don't inspect
// the trigger, because there appears to be no way of determining the _default_
// trigger, so we'd need a separate boot time mechanism to save this information.
const MORSE_ASSOC_LED = "/sys/class/leds/morse_led0";
const DPP_STARTED_LED_INTERVAL = 1000;
const DPP_FAILED_LED_INTERVAL = 100;


function start_listener(path) {
	system(["killall", "wpa_event_listener"]);
	system(["wpa_event_listener", "-B", "-p", path, "-a",  DPP_ACTION_SCRIPT]);
	// Wait a sec for listener to have connected to socket, otherwise we might
	// miss the start action.
	sleep(1000);
}


function get_lockout_secs() {
	const clock_monotonic_secs = clock(true)[0];
	try {
		if (access(DPP_STATE_INFO)) {
			const dpp_state_info = json(readfile(DPP_STATE_INFO));
			if (dpp_state_info && dpp_state_info.lockout_finish_secs > clock_monotonic_secs) {
				return dpp_state_info.lockout_finish_secs - clock_monotonic_secs;
			}
		}
	} catch (e) {
		warn(`Unable to read ${DPP_STATE_INFO}: `, e, "\n");
	}

	return 0;
}


function set_new_lockout_secs(lockout_secs) {
	const clock_monotonic_secs = clock(true)[0];

	writefile(DPP_STATE_INFO, {
		lockout_finish_secs: clock_monotonic_secs + lockout_secs,
	});
}


function push_button(req) {
	let mode = req.args.mode;
	const all_mode_info = {
		ap: {
			control: "/var/run/hostapd_s1g/",
			cli: "hostapd_cli_s1g",
		},
		sta: {
			control: "/var/run/wpa_supplicant_s1g/",
			cli: "wpa_cli_s1g",
		},
	};

	const proposed_modes = mode ? [mode] : ["ap", "sta"];
	let mode_info = null;

	for (let mode in proposed_modes) {
		if (access(all_mode_info[mode].control)) {
			mode_info = all_mode_info[mode];
			break;
		}
	}

	if (!mode_info) {
		return {
			"error": "Unable to discover an active morse interface to trigger DPP push button on",
			"error_code": "no_available_mode"
		}
	}

	const lockout_remaining_secs = get_lockout_secs();
	if (lockout_remaining_secs) {
		return {
			error: `DPP button already pressed recently. Please wait {lockout_remaining_seconds} more seconds to avoid overlap.`,
			error_code: "lockout",
			lockout_remaining_secs,
		}
	}

	start_listener(mode_info.control);
	const exit_code = system([mode_info.cli, "dpp_push_button"], 1000);

	if (exit_code != 0) {
		return {
			error: "Failed to start DPP interaction (internal error)",
			error_code: "internal_error",
		}
	}

	// Wait 5 secs for the first 'set_state' to come back from wpa_event_listener.
	// If this doesn't happen, then something internal has gone wrong, and we shouldn't
	// lock out.
	set_new_lockout_secs(5);

	return {
		lockout_remaining_secs: 5,
	}
}


function morse_led_handler(diag_state) {
	function write_led(led, key, val) {
		writefile(`${led}/${key}`, val);
	}

	switch (diag_state) {
		case "dpp_started":
			write_led(MORSE_ASSOC_LED, "trigger", "timer");
			write_led(MORSE_ASSOC_LED, "delay_off", DPP_STARTED_LED_INTERVAL);
			write_led(MORSE_ASSOC_LED, "delay_on", DPP_STARTED_LED_INTERVAL);
			break;
		case "dpp_failed":
			write_led(MORSE_ASSOC_LED, "trigger", "timer");
			write_led(MORSE_ASSOC_LED, "delay_off", DPP_FAILED_LED_INTERVAL);
			write_led(MORSE_ASSOC_LED, "delay_on", DPP_FAILED_LED_INTERVAL);
			break;
		case "done":
			const phy = lsdir(`${MORSE_ASSOC_LED}/device/ieee80211`)[0];
			if (phy) {
				write_led(MORSE_ASSOC_LED, "trigger", `${phy}assoc`);
			}
			break;
	}
}


function set_state(req) {
	const state = req.args.state;
	const lockout_secs = req.args.lockout_secs;
	let diag_state = null;

	if (lockout_secs) {
		set_new_lockout_secs(lockout_secs);
	}

	switch (state) {
		case "finished":
			diag_state = "done";
			// Finished is either success or after the lockout timeout, so we
			// can remove the state file.
			unlink(DPP_STATE_INFO);
			break;
		case "failed":
			diag_state = "dpp_failed";
			break;
		case "started":
			diag_state = "dpp_started";
			break;
	}

	if (diag_state) {
		if (access(MORSE_ASSOC_LED)) {
			// If there is a morse LED (prob from the driver), use this.
			morse_led_handler(diag_state);
		} else {
			// Use existing system LED handler to show DPP interaction.
			system(`. /etc/diag.sh && set_state ${diag_state}`)
		}
	}

	return {};
}


/* If uci changes have been made, commit and notify.
 */
function commit_config(ubus, uci) {
	const config_files = keys(uci.changes());

	if (length(keys(config_files)) < 0) {
		return;
	}

	assert(uci.commit(), "Failed to commit changed config");

	// Tell procd about the changes, as /bin/reload_config does.
	for (let cf in config_files) {
		if (!ubus.call("service", "event", { type: "config.change", data: { package: cf } })) {
			warn(ubus.error(), "\n");
		}
	}
}


function get_uci_wireless_section(ubus, ifname) {
	const wireless_status = ubus.call("network.wireless", "status");
	assert(wireless_status, "No current wireless status available via ubus");

	for (let radio in values(wireless_status)) {
		if (radio["interfaces"]) {
			for (let iface in radio["interfaces"]) {
				if (iface["ifname"] === ifname) {
					return iface["section"];
				}
			}
		}
	}

	assert(false, `Could not find UCI section with ${ifname} to update`);
}


function apply_config(req) {
	const uci = cursor();
	const ubus = connect();
	const c = req.args.config;

	assert(c, "no config object for apply_config");
	assert(c.iface_name, "config missing iface_name");
	assert(c.encryption, "config missing encryption");
	assert(c.ssid, "config missing ssid");
	if (!(c.encryption in ["owe", "none"])) {
		assert(c.key, "config missing key");
	}

	const section_name = get_uci_wireless_section(ubus, c.iface_name);

	uci.set("wireless", section_name, "encryption", c.encryption);
	uci.set("wireless", section_name, "ssid", c.ssid);
	uci.set("wireless", section_name, "key", c.key);
	// If we've come in because of dpp chirping (i.e. qrcode dpp), it needs to be disabled.
	uci.delete("wireless", section_name, "dpp");
	commit_config(ubus, uci);
	return {};
}


return { dpp: {
	push_button: {
		call: push_button,
		args: {
			mode: "",
		}
	},

	get_lockout_secs: {
		call: () => ({ lockout_remaining_secs: get_lockout_secs() }),
	},

	// called by wpa_event_listener via wpa_s1g_dpp_action.sh
	set_state: {
		call: set_state,
		args: {
			state: "",
			lockout_secs: 0,
		},
	},

	// called by wpa_event_listener via wpa_s1g_dpp_action.sh
	apply_config: {
		call: apply_config,
		args: {
			config: {},
		},
	},
}};
